// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso do sistema.
// ADMIN_GERAL é exclusivo do dono da plataforma (não pertence a nenhuma loja,
// gerencia todas as lojas/licenças e pode entrar em modo suporte).
// Os demais perfis pertencem sempre a uma Loja (CNPJ) específica:
// DONO e GERENTE enxergam tudo dentro da loja, incluindo financeiro.
// CAIXA opera o PDV/fechamento de comandas.
// GARCOM lança pedidos nas comandas pelo celular.
// COZINHA acompanha o painel de pedidos.
enum Perfil {
  ADMIN_GERAL
  DONO
  GERENTE
  CAIXA
  GARCOM
  COZINHA
}

// Status da licença de uso de cada loja na plataforma.
enum StatusLoja {
  TESTE
  ATIVA
  SUSPENSA
}

// Cada Loja representa um CNPJ cliente da plataforma. Todo dado operacional
// (produtos, estoque, comandas, vendas, financeiro) vai pertencer a uma Loja,
// e nunca pode vazar de uma Loja para outra.
model Loja {
  id           String     @id @default(cuid())
  nomeFantasia String
  razaoSocial  String?
  cnpj         String     @unique
  status       StatusLoja @default(TESTE)
  criadaEm     DateTime   @default(now())

  usuarios       Usuario[]
  acessosSuporte LogAcessoSuporte[]
  categorias     Categoria[]
  produtos       Produto[]
  movimentosEstoque  MovimentoEstoque[]
  notasFiscaisCompra NotaFiscalCompra[]
  comandas           Comanda[]
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  // Nula apenas para o(s) usuário(s) ADMIN_GERAL. Todo usuário de loja
  // (DONO, GERENTE, CAIXA, GARCOM, COZINHA) deve ter uma lojaId.
  lojaId String?
  loja   Loja?   @relation(fields: [lojaId], references: [id])

  criadoPorId     String?
  criadoPor       Usuario?  @relation("UsuarioCriadoPor", fields: [criadoPorId], references: [id])
  usuariosCriados Usuario[] @relation("UsuarioCriadoPor")

  acessosSuporteFeitos LogAcessoSuporte[] @relation("AdminQueAcessou")

  movimentosEstoqueCriados MovimentoEstoque[]
  notasFiscaisCriadas      NotaFiscalCompra[]

  comandasAbertas         Comanda[]     @relation("ComandaAbertaPor")
  comandasFechadas        Comanda[]     @relation("ComandaFechadaPor")
  itensComandaAdicionados ItemComanda[]
}

// Registro de auditoria: toda vez que o Admin Geral entra em "modo suporte"
// dentro de uma loja, fica registrado aqui (quem, qual loja, quando entrou
// e quando saiu). Isso é parte da prestação de contas exigida pela LGPD.
model LogAcessoSuporte {
  id     String @id @default(cuid())
  adminId String
  admin   Usuario @relation("AdminQueAcessou", fields: [adminId], references: [id])
  lojaId  String
  loja    Loja    @relation(fields: [lojaId], references: [id])

  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?
}

// SIMPLES: produto "de uma peça só" (pode ser vendido direto e/ou usado
// como insumo em receitas). COMPOSTO: "ficha técnica" — feito a partir de
// outros produtos (ex: um sanduíche feito de pão, presunto e queijo).
enum TipoProduto {
  SIMPLES
  COMPOSTO
}

// Categorias e subcategorias de produtos, sempre dentro de uma loja.
model Categoria {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  nome           String
  categoriaPaiId String?
  categoriaPai   Categoria?  @relation("Subcategorias", fields: [categoriaPaiId], references: [id])
  subcategorias  Categoria[] @relation("Subcategorias")

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  produtos Produto[]

  @@unique([lojaId, categoriaPaiId, nome])
}

model Produto {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  nome          String
  descricao     String?
  tipo          TipoProduto @default(SIMPLES)
  unidadeMedida String      @default("un")

  // Se o produto aparece à venda (no PDV/comandas) ou é só um insumo
  // usado dentro de fichas técnicas de outros produtos.
  vendavel Boolean @default(true)

  // Preço de venda "base". Só é usado quando o produto não tem variações
  // (cada variação tem seu próprio preço).
  precoVenda Decimal? @db.Decimal(10, 2)

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  // Quantidade atual em estoque (mantida atualizada a cada movimento) e o
  // nível mínimo a partir do qual o produto entra no alerta de estoque
  // baixo. Para produtos COMPOSTO, quem tem estoque de verdade são os
  // insumos da ficha técnica — o estoque do composto normalmente fica 0.
  estoqueAtual  Decimal @default(0) @db.Decimal(12, 3)
  estoqueMinimo Decimal @default(0) @db.Decimal(12, 3)

  variacoes Variacao[]

  // Ingredientes deste produto, quando ele é do tipo COMPOSTO.
  itensFichaTecnica ItemFichaTecnica[] @relation("ProdutoComposto")
  // Receitas de outros produtos em que este produto é usado como insumo.
  usadoComoInsumoEm ItemFichaTecnica[] @relation("ProdutoInsumo")

  movimentosEstoque   MovimentoEstoque[]
  itensNotaFiscal     ItemNotaFiscalCompra[]
  itensComanda        ItemComanda[]

  @@unique([lojaId, nome])
}

// Variações simples de um produto (ex: "Pequeno"/"Grande", "Morango"),
// cada uma com seu próprio preço de venda.
model Variacao {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  nome       String
  precoVenda Decimal @db.Decimal(10, 2)
  ativo      Boolean @default(true)

  itensComanda ItemComanda[]

  @@unique([produtoId, nome])
}

// Um "item" da ficha técnica: quanto de um insumo (outro Produto) entra
// na receita de um produto composto.
model ItemFichaTecnica {
  id String @id @default(cuid())

  produtoId String
  produto   Produto @relation("ProdutoComposto", fields: [produtoId], references: [id], onDelete: Cascade)

  insumoId String
  insumo   Produto @relation("ProdutoInsumo", fields: [insumoId], references: [id])

  quantidade Decimal @db.Decimal(10, 3)

  @@unique([produtoId, insumoId])
}

// Todo movimento de estoque (entrada ou saída) fica registrado aqui —
// é o "extrato" que explica por que a quantidade de um produto mudou.
enum TipoMovimentoEstoque {
  ENTRADA_COMPRA // veio de uma nota fiscal de compra
  ENTRADA_AJUSTE // correção manual (para mais)
  SAIDA_VENDA // baixa por venda (direta ou via ficha técnica)
  SAIDA_AJUSTE // correção manual (para menos)
  SAIDA_PERDA // quebra, validade vencida, etc.
}

model MovimentoEstoque {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  tipo TipoMovimentoEstoque
  // Sempre um valor positivo — o "tipo" indica se soma ou subtrai do
  // estoque atual do produto.
  quantidade Decimal @db.Decimal(12, 3)

  observacao String?
  criadoEm   DateTime @default(now())

  criadoPorId String?
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])

  // Preenchido quando o movimento veio de um item de nota fiscal de compra.
  itemNotaFiscalId String?               @unique
  itemNotaFiscal   ItemNotaFiscalCompra? @relation(fields: [itemNotaFiscalId], references: [id])
}

enum OrigemNotaFiscal {
  XML
  MANUAL
}

// Cabeçalho de uma nota fiscal de compra (do fornecedor), seja importada
// por XML (NF-e) ou digitada manualmente.
model NotaFiscalCompra {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  numero         String?
  fornecedorNome String?
  fornecedorCnpj String?
  dataEmissao    DateTime?
  valorTotal     Decimal?         @db.Decimal(12, 2)
  origem         OrigemNotaFiscal

  // Chave de acesso de 44 dígitos do XML da NF-e. Evita importar a mesma
  // nota duas vezes por engano.
  chaveAcesso String? @unique

  criadoEm    DateTime @default(now())
  criadoPorId String?
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])

  itens ItemNotaFiscalCompra[]
}

model ItemNotaFiscalCompra {
  id           String           @id @default(cuid())
  notaFiscalId String
  notaFiscal   NotaFiscalCompra @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  // Descrição exatamente como veio na nota — útil se o produto interno
  // for renomeado depois, para não perder a referência de origem.
  descricaoOriginal String
  quantidade        Decimal @db.Decimal(12, 3)
  valorUnitario     Decimal? @db.Decimal(12, 4)
  valorTotal        Decimal? @db.Decimal(12, 2)

  movimentoEstoque MovimentoEstoque?
}

// Comanda por mesa (ex: "Mesa 5") ou avulsa/numerada (ex: "Comanda 12").
enum TipoComanda {
  MESA
  AVULSA
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

model Comanda {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  // Número sequencial da comanda dentro da loja (mostrado ao cliente/garçom
  // independente do tipo, ex: "Comanda #12").
  numero Int

  tipo TipoComanda
  // Identificador da mesa (ex: "5", "Varanda 2") — só para tipo MESA.
  mesa String?

  status    StatusComanda @default(ABERTA)
  abertaEm  DateTime      @default(now())
  fechadaEm DateTime?

  abertaPorId String?
  abertaPor   Usuario? @relation("ComandaAbertaPor", fields: [abertaPorId], references: [id])

  fechadaPorId String?
  fechadaPor   Usuario? @relation("ComandaFechadaPor", fields: [fechadaPorId], references: [id])

  itens      ItemComanda[]
  pagamentos Pagamento[]

  @@unique([lojaId, numero])
}

// Formas de pagamento aceitas no fechamento da comanda (Caixa/PDV).
enum FormaPagamento {
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX
  OUTRO
}

// Um ou mais pagamentos que fecham uma comanda (permite dividir a conta
// entre formas diferentes, ex: metade no cartão e metade em dinheiro).
model Pagamento {
  id        String  @id @default(cuid())
  comandaId String
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  forma FormaPagamento
  valor Decimal        @db.Decimal(10, 2)

  criadoEm DateTime @default(now())
}

enum StatusItemComanda {
  PENDENTE // acabou de ser lançado pelo garçom
  EM_PREPARO // a cozinha começou a preparar
  PRONTO // pronto para servir
  ENTREGUE // já foi levado à mesa/cliente
  CANCELADO
}

model ItemComanda {
  id        String  @id @default(cuid())
  comandaId String
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  variacaoId String?
  variacao   Variacao? @relation(fields: [variacaoId], references: [id])

  quantidade Decimal @db.Decimal(10, 3)
  // Preço "congelado" no momento do lançamento — se o preço do produto
  // mudar depois, os itens já lançados não são afetados.
  precoUnitario Decimal @db.Decimal(10, 2)

  observacao String?
  status     StatusItemComanda @default(PENDENTE)

  criadoEm    DateTime @default(now())
  criadoPorId String?
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])
}
