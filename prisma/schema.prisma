// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso do sistema.
// ADMIN_GERAL é exclusivo do dono da plataforma (não pertence a nenhuma loja,
// gerencia todas as lojas/licenças e pode entrar em modo suporte).
// Os demais perfis pertencem sempre a uma Loja (CNPJ) específica:
// DONO e GERENTE enxergam tudo dentro da loja, incluindo financeiro.
// CAIXA opera o PDV/fechamento de comandas.
// GARCOM lança pedidos nas comandas pelo celular.
// COZINHA acompanha o painel de pedidos.
enum Perfil {
  ADMIN_GERAL
  DONO
  GERENTE
  CAIXA
  GARCOM
  COZINHA
}

// Status da licença de uso de cada loja na plataforma.
enum StatusLoja {
  TESTE
  ATIVA
  SUSPENSA
}

// Cada Loja representa um CNPJ cliente da plataforma. Todo dado operacional
// (produtos, estoque, comandas, vendas, financeiro) vai pertencer a uma Loja,
// e nunca pode vazar de uma Loja para outra.
model Loja {
  id           String     @id @default(cuid())
  nomeFantasia String
  razaoSocial  String?
  cnpj         String     @unique
  status       StatusLoja @default(TESTE)
  criadaEm     DateTime   @default(now())

  usuarios       Usuario[]
  acessosSuporte LogAcessoSuporte[]
  categorias     Categoria[]
  produtos       Produto[]
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  // Nula apenas para o(s) usuário(s) ADMIN_GERAL. Todo usuário de loja
  // (DONO, GERENTE, CAIXA, GARCOM, COZINHA) deve ter uma lojaId.
  lojaId String?
  loja   Loja?   @relation(fields: [lojaId], references: [id])

  criadoPorId     String?
  criadoPor       Usuario?  @relation("UsuarioCriadoPor", fields: [criadoPorId], references: [id])
  usuariosCriados Usuario[] @relation("UsuarioCriadoPor")

  acessosSuporteFeitos LogAcessoSuporte[] @relation("AdminQueAcessou")
}

// Registro de auditoria: toda vez que o Admin Geral entra em "modo suporte"
// dentro de uma loja, fica registrado aqui (quem, qual loja, quando entrou
// e quando saiu). Isso é parte da prestação de contas exigida pela LGPD.
model LogAcessoSuporte {
  id     String @id @default(cuid())
  adminId String
  admin   Usuario @relation("AdminQueAcessou", fields: [adminId], references: [id])
  lojaId  String
  loja    Loja    @relation(fields: [lojaId], references: [id])

  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?
}

// SIMPLES: produto "de uma peça só" (pode ser vendido direto e/ou usado
// como insumo em receitas). COMPOSTO: "ficha técnica" — feito a partir de
// outros produtos (ex: um sanduíche feito de pão, presunto e queijo).
enum TipoProduto {
  SIMPLES
  COMPOSTO
}

// Categorias e subcategorias de produtos, sempre dentro de uma loja.
model Categoria {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  nome           String
  categoriaPaiId String?
  categoriaPai   Categoria?  @relation("Subcategorias", fields: [categoriaPaiId], references: [id])
  subcategorias  Categoria[] @relation("Subcategorias")

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  produtos Produto[]

  @@unique([lojaId, categoriaPaiId, nome])
}

model Produto {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  nome          String
  descricao     String?
  tipo          TipoProduto @default(SIMPLES)
  unidadeMedida String      @default("un")

  // Se o produto aparece à venda (no PDV/comandas) ou é só um insumo
  // usado dentro de fichas técnicas de outros produtos.
  vendavel Boolean @default(true)

  // Preço de venda "base". Só é usado quando o produto não tem variações
  // (cada variação tem seu próprio preço).
  precoVenda Decimal? @db.Decimal(10, 2)

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  variacoes Variacao[]

  // Ingredientes deste produto, quando ele é do tipo COMPOSTO.
  itensFichaTecnica ItemFichaTecnica[] @relation("ProdutoComposto")
  // Receitas de outros produtos em que este produto é usado como insumo.
  usadoComoInsumoEm ItemFichaTecnica[] @relation("ProdutoInsumo")

  @@unique([lojaId, nome])
}

// Variações simples de um produto (ex: "Pequeno"/"Grande", "Morango"),
// cada uma com seu próprio preço de venda.
model Variacao {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  nome       String
  precoVenda Decimal @db.Decimal(10, 2)
  ativo      Boolean @default(true)

  @@unique([produtoId, nome])
}

// Um "item" da ficha técnica: quanto de um insumo (outro Produto) entra
// na receita de um produto composto.
model ItemFichaTecnica {
  id String @id @default(cuid())

  produtoId String
  produto   Produto @relation("ProdutoComposto", fields: [produtoId], references: [id], onDelete: Cascade)

  insumoId String
  insumo   Produto @relation("ProdutoInsumo", fields: [insumoId], references: [id])

  quantidade Decimal @db.Decimal(10, 3)

  @@unique([produtoId, insumoId])
}
