# Copie este arquivo para ".env" e preencha com valores reais.
# O arquivo ".env" nunca é enviado ao Git (fica só na sua máquina/servidor).

# Endereço de conexão com o banco de dados PostgreSQL.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/reserva88?schema=public"

# Chave secreta usada para assinar as sessões de login. Gere uma com: openssl rand -base64 32
SESSION_SECRET=""

# Dados usados apenas uma vez, para criar a primeira conta (dono) com "npm run db:seed".
ADMIN_NOME="Administrador"
ADMIN_EMAIL=""
ADMIN_SENHA=""
